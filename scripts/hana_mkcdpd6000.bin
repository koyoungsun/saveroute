<script type="text/javascript">
//<![CDATA[
var isCardSearch = false;

if("" != ""){
	isCardSearch = true;
}

$(function() {
	
	// 항목 선택
	$(":checkbox[id^=card]").on("click", function() {
		var item = $(this).attr("id").split("_")[1];
		
		$("#"+ item).val("");
		
		if (item == "benefitCds" && $(":checkbox[id^=card_"+ item +"]:checked").length > 2) {
			$(":checkbox[id^=card_"+ item +"]:not(input:checked)").attr("disabled", true);
		} else {
			$(":checkbox[id^=card_"+ item +"]").attr("disabled", false);
		}
		
		var values = new Array();
		$(":checkbox[id^=card_"+ item +"]:checked").each(function() {
			values.push($(this).attr("id").split("_")[2]);
		});
		if (values.length > 0) {
			$("#"+ item).val(values);
		}
	});
	
	// 전체 목록
	var reqMap = {
		targetMethod   : "cardList",
		page           : '1',
		rowNum         : $("#cardListRowNum").val(),
		benefitCds     : $("#benefitCds").val(),
		benefitTypeCds : $("#benefitTypeCds").val(),
		cdTps          : $("#cdTps").val(),
		gradeCds       : $("#gradeCds").val(),
		brandIds       : $("#brandIds").val(),
		feeCds         : $("#feeCds").val()
	};
// 	REQ_MAP = reqMap;
	ajaxExceute("MKCDPD6010M.ajax", reqMap, cardMoreCallback);
	
	if(!isCardSearch){
		uiJSLayer.open('layer-find-my-card', $("#selectBenefitBtn"));	
	}
	
	
});

function checkboxBenefit(obj) {
	if ($("#"+ $(obj).attr("for")).prop("disabled")) {
		alert("혜택은 3개만 선택가능합니다.");
		return;
	} else {
		// nothing.
	}
}

// 초기화
function cardReset() {
	$(":checkbox[id^=card]").each(function() {
		if ($(this).is(":checked")) {
			$(this).prop("checked", false);
			$("#"+ $(this).attr("id").split("_")[1]).val("");
		}
		if($(this).is(":disabled")){
			$(this).prop("disabled", false);	
		}
		
	});
}

// 검색
function cardSearch() {
	isCardSearch = true;
	
	//$("#totalCount").text('0');
	$("#cardList").html('');
	$("#cardListPage").val("0");
	
	//GA 태깅 추가
	sendGaData();
	
	cardMore();
	
	uiJSLayer.close('layer-find-my-card');
}

// 더보기
function cardMore() {

	var page = Number($("#cardListPage").val())+1;
	
	var reqMap = {
		targetMethod   : "cardList",
		page           : page,
		rowNum         : $("#cardListRowNum").val(),
		benefitCds     : $("#benefitCds").val(),
		benefitTypeCds : $("#benefitTypeCds").val(),
		cdTps          : $("#cdTps").val(),
		gradeCds       : $("#gradeCds").val(),
		brandIds       : $("#brandIds").val(),
		feeCds         : $("#feeCds").val()
	};
	ajaxExceute("MKCDPD6010M.ajax", reqMap, cardMoreCallback);
}
function cardMoreCallback(dataMap) {
	var cardData = dataMap.cardList;
	var cardHtml = '';
	
	if (isNotEmpty(dataMap.totalCnt)) {
		$("#cardListTotalCnt").val(dataMap.totalCnt);
	}
	$("#totalCntText").text(dataMap.totalCnt);
	
	var cardCompareButtonClass = "";
	var cardCompareButtonTitle = "";
	
	if (cardData != null && cardData.length > 0) {
		if ($("#cardList .card-item").hasClass("focusOn")) {
			$("#cardList .card-item").removeClass("focusOn");
		}
		

		for (var i=0; i<cardData.length; i++) {
			cardHtml +=
						'<li class="card-item"'+ (i == 0 ? 'focusOn' : '') +'" '+ (i == 0 ? 'tabindex="1"' : '') +'>'+
							'<div class="card-block">';
			
			var cardTooltip = isEmpty(cardData[i].LIST_TOOLTIP) ? (cardData[i].CD_DESC_TXT +' '+ cardData[i].CD_NM) : cardData[i].LIST_TOOLTIP;
			
			
			cardHtml += '		<span class="card-image">';
			cardHtml += '			<a href="javascript:goDetailPage(\''+cardData[i].CD_NO+'\',\''+cardData[i].CD_NM+'\');" class="display-block" role="button">';
			cardHtml += '				<span class="card-image-inner">';
			cardHtml += '					<img src="'+ cardData[i].LIST_LIS_TYPE_IMG +'" alt="'+ cardTooltip +'" onerror="this.parentNode.className += \' is-error\';" />';
			cardHtml += '				</span>';
			cardHtml += '			</a>';
									
								if (CardCompare.cookieValidation(cardData[i].CD_ID)) {
									cardCompareButtonClass = "card-button-add is-active";
									cardCompareButtonTitle = "삭제";
								} else {
									cardCompareButtonClass = "card-button-add";
									cardCompareButtonTitle = "추가";
								}
								
								if (cardData[i].COMP_FLAG == "T") {
			cardHtml +=
									'<button type="button" id="cardCompareBox_'+ cardData[i].CD_ID +'" onclick="cardCompareBox(\''+ cardData[i].CD_ID +'\', \''+ cardData[i].CD_NO +'\', \''+ cardData[i].CD_NM +'\', \''+ cardData[i].LIST_LIS_TYPE_IMG +'\');" class="'+ cardCompareButtonClass +'" title="'+ cardCompareButtonTitle +'">비교함</button>';
								}
								
			cardHtml +=
								'</span>'+
								'<a href="javascript:goDetailPage(\''+cardData[i].CD_NO+'\',\''+cardData[i].CD_NM+'\');" class="card-info" role="button">'+
									'<span class="card-name">'+ cardData[i].CD_NM +'</span>';
								
								var iconData = cardData[i].EXP_ICON_DT_LIST;
								
								if (isNotEmpty(iconData)) {
			cardHtml +=
									'<div class="card-number">';
									for (var j=0; j<iconData.length; j++) {
			cardHtml +=
										'<div>'+ iconData[j].ICON_TIT_NM +' <span class="color-primary">'+ iconData[j].ICON_DESC +'</span></div>';
									}
			cardHtml +=
									'</div>';
								}
									
								/**
								 * 우선순위 : 연회비 > 이벤트 > 추천 > 인기 > 신규
								 * 
								 * ICON_YN : 아이콘 사용여부(TF)
								 *  - HANA_ICON_FLAG : 연회비이벤트(YN)
								 *  - EVT_ICON_FLAG  : 이벤트(YN)
								 *  - RCM_ICON_FLAG  : 추천(YN)
								 *  - PO_ICON_FLAG   : 인기(YN)
								 *  - NEW_ICON_FLAG  : NEW(YN)
								 *  - FML_ICON_FLAG  : 가족카드(YN)
								 *  - DRT_ICON_FLAG  : 바로발급(YN)
								 */
								if (cardData[i].ICON_YN == "T") {
									var iconHtml  = '';
									var iconCount = 0; // 최대 2개까지 노출
									
									if (cardData[i].HANA_ICON_FLAG == "Y") {
										iconHtml += '<span class="ui-badge ">연회비이벤트</span>';
										iconCount++;
									}
									if (cardData[i].EVT_ICON_FLAG == "Y") {
										iconHtml += '<span class="ui-badge ">이벤트</span>';
										iconCount++;
									}
									if (cardData[i].RCM_ICON_FLAG == "Y" && iconCount < 2) {
										iconHtml += '<span class="ui-badge color-wrong">추천</span>';
										iconCount++;
									}
									if (cardData[i].PO_ICON_FLAG == "Y" && iconCount < 2) {
										iconHtml += '<span class="ui-badge ">인기</span>';
										iconCount++;
									}
									if (cardData[i].NEW_ICON_FLAG == "Y" && iconCount < 2) {
										iconHtml += '<span class="ui-badge type-point">New</span>';
										iconCount++;
									}
									if (cardData[i].FML_ICON_FLAG == "Y" && iconCount < 2) {
										iconHtml += '<span class="ui-badge color-secondary">가족카드</span>';
										iconCount++;
									}
									if (cardData[i].DRT_ICON_FLAG == "Y" && iconCount < 2) {
										iconHtml += '<span class="ui-badge color-primary-dark">바로발급</span>';
										iconCount++;
									}
									if (iconCount > 0) {
			cardHtml +=
									'<div class="card-badges">'+
										iconHtml +
									'</div>';
									}
									
								} // E : if (cardData[i].ICON_YN == "T") {									
			cardHtml +=
								'</a>'+
							'</div>'+
						'</li>';
		} // E : for (var i=0; i<cardData.length; i++) {
		
		if (isNotEmpty(dataMap.totalPage)) {
			$("#cardListTotalPage").val(dataMap.totalPage);
		}
		if (isNotEmpty(dataMap.page)) {
			$("#cardListPage").val(dataMap.page);
		}
		
		
		$("#cardList").append(cardHtml);
		$("#cardCompare").show();
		
		
		var totalPage = parseInt($("#cardListTotalPage").val(), 10);
		var page      = parseInt($("#cardListPage").val(), 10);
		if (page < totalPage) {
			$("#moreBtn").show();
		}else{
			$("#moreBtn").hide();
		}

		$("#isEmptyCardList").hide();
		$("#isNotEmptyCardList").show();
		
	} else {
		$("#isEmptyCardList").show();
		
		$("#isNotEmptyCardList").hide();
		//더보기보기 미노출
		$("#moreBtn").hide();
	}
	
 								
	if($("#layer-find-my-card").find(":checkbox:checked").length > 0){
		$("#selectBenefitText").text($("#layer-find-my-card").find(":checkbox:checked").map(function(){
			return $(this).attr("data-benefitNm");
		}).get().join('ㆍ'));
		
	}else{
		$("#selectBenefitText").text("전체");
	}
								
	
	if ($("#cardList .card-block.focusOn").length > 0) {
		$("#cardList .card-block.focusOn").focus();
	}
	
}

// 카드 비교함
function cardCompareBox(id, no, nm, img) {
	var card = new Object;
		card.CD_ID             = id;
		card.CD_NO             = no;
		card.CD_NM             = nm;
		card.LIST_IMG_TYPE_IMG = img;
	
	if (CardCompare.cookieValidation(id)) {
		CardCompare.remove(id);
		$("button[id=cardCompareBox_"+ id +"]").removeClass('is-active').attr('title', '추가');
	} else {
		if (CardCompare.add(card)) {
			$("button[id=cardCompareBox_"+ id +"]").addClass('is-active').attr('title', '삭제');
		}else{
			$("button[id=cardCompareBox_"+ id +"]").removeClass('is-active').attr('title', '추가');
		}
	}
	
}


function sendGaData(){
	
	//주요혜택
	$("#benefitGroup").find(":checkbox:checked").each(function(){
		GA_Event('통합앱_나만의카드찾기','필터_주요혜택', $(this).attr("data-benefitNm"));
	});
	
	//혜택유형
	$("#benefitTypeGroup").find(":checkbox:checked").each(function(){
		GA_Event('통합앱_나만의카드찾기','필터_혜택유형', $(this).attr("data-benefitNm"));
	});
	
	//등급
	$("#benefitGradeGroup").find(":checkbox:checked").each(function(){
		GA_Event('통합앱_나만의카드찾기','필터_등급', $(this).attr("data-benefitNm"));
	});
	
	//브랜드
	$("#benefitBrandGroup").find(":checkbox:checked").each(function(){
		GA_Event('통합앱_나만의카드찾기','필터_브랜드', $(this).attr("data-benefitNm"));
	});
	
	//연회비
	$("#benefitFeeGroup").find(":checkbox:checked").each(function(){
		GA_Event('통합앱_나만의카드찾기','필터_연회비', $(this).attr("data-benefitNm"));
	});
	
}


//카드상세 +GA태깅
function goDetailPage(cdPdSeq, cdNm){
	GA_Event_Fn("통합앱_나만의카드찾기", "나만의카드찾기결과", cdNm, "", goLinkWeb('/MKCDCM1000M.web?CD_PD_SEQ='+cdPdSeq));
}

//]]>
</script>


