	/**
	 * 카드이미지 로드 에러
	 * ty : 개인/법인 구분
	 *      - P : 개인 (DEFAULT)
	 *      - C : 법인
	 */
	function cardImageError(obj, ty) {
		var errImgSrc = "/images/common/card-default.svg";
		if("C" == ty){
			errImgSrc = "/images/common/card-default.svg";
		}
		obj.onerror = null;
		obj.src = errImgSrc;
	}
