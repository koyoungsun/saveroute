	<input type="hidden" id="cardListPage"   value="1">
	<input type="hidden" id="cardListRowNum" value="10">
	<input type="hidden" id="cardListTotalCnt">
	<input type="hidden" id="cardListTotalPage">
	
	<input type="hidden" id="benefitCds"     name="benefitCds">
	<input type="hidden" id="benefitTypeCds" name="benefitTypeCds">
	<input type="hidden" id="cdTps"          name="cdTps">
	<input type="hidden" id="gradeCds"       name="gradeCds">
	<input type="hidden" id="brandIds"       name="brandIds" value="">
	<input type="hidden" id="feeCds"         name="feeCds">
	
	
</form>
<div class="contents-wrap">
	<div class="page-contents">
		<div class="link-row align-right">
			<div class="ui-select-small-block">
				<button type="button" class="ui-button ui-select-small" title="조회 월 선택" data-layer-open="layer-find-my-card" onclick="GA_Event('통합앱_나만의카드찾기','나만의카드찾기결과', '필터설정');" id="selectBenefitBtn"><span class="default-text" id="selectBenefitText"></span></button>
			</div>
		</div>

		<div class="page-section-group type-line margin-top-15">
			<p class="check-detail-title margin-top-minus-10 margin-bottom-25 font-weight-medium" >총&nbsp;<strong class="color-secondary" id="totalCntText"></strong>개</p>

			<!-- Case : 검색 결과 없을 때 -->
			<div class="link-item type-none type-flex type-no-line type-no-padding" id="isEmptyCardList" style="display: none;">
				<p class="item-text">검색된 결과가 없습니다.</p>
			</div>
			<!-- Case : //검색 결과 없을 때 -->

			<div class="cards margin-top-none" id="isNotEmptyCardList" style="display: none;">
