    <script>
    $(document).ready(function() {
    	$(".ui-checkbox-block").on("change", function() {
    		var a = $(this).find("span.card-name").text().trim();
    		var b = $(this).find("span.ui-label-text").text().trim();
    		var c = $(this).parent().parent().siblings().find("span.card-name").text().trim();
    		var d = $(this).parent().parent().parent().siblings().find("span.ui-label-text").text().trim();
    		if(a.length > 0) {
				if($(this).find("input[type=radio]").is(":checked")) {
    				$(this).find("input[type=radio]").attr("title", a+", 선택됨");
    				$(this).parent().siblings().find("span.card-name").each(function(i, el) {
    					var b = $(el).text().trim();
    					if(b.length > 0) {
    						$(el).parent().parent().parent().siblings().attr("title", b);
    					}
    				});
    			} else if($(this).find("input[type=checkbox]").is(":checked") == true) {
    				$(this).find("input[type=checkbox]").attr("title", a+", 선택됨");
    				if(d.length > 0 && $(this).parent().parent().parent().siblings().find("input[type=checkbox]").is(":checked")) {
    					$(this).parent().parent().parent().siblings().find("input[type=checkbox]").attr("title", d+", 선택됨");
    				}
    			} else if($(this).find("input[type=checkbox]").is(":checked") == false) {
    				$(this).find("input[type=checkbox]").attr("title", a);
    				if(d.length > 0) {
    					$(this).parent().parent().parent().siblings().find("input[type=checkbox]").attr("title", d);
    				}
    			}
    		} else if(b.length > 0) {
    			if($(this).parents(".ui-select-terms.wcms-section").length > 0) {
    				if($(this).find("input[type=checkbox]").is(":checked")) {
        				$(this).find("input[type=checkbox]").attr("title", b+", 선택됨");
        			} else {
        				$(this).find("input[type=checkbox]").attr("title", b);
        			}
    			} else if($(this).find("input[id^=allChkCards]").length > 0) {
    				if($(this).find("input[type=checkbox]").is(":checked")) {
        				$(this).find("input[type=checkbox]").attr("title", b+", 선택됨");
        				if(c.length > 0) {
        					$(this).parent().parent().siblings().find("span.card-name").each(function(i, el) {
        						var b = $(el).text().trim();
            					if(b.length > 0) {
            						$(el).parent().parent().parent().parent().find("input[type=checkbox]").attr("title", b+", 선택됨");
            					}
        					});
        				}
        			} else {
        				$(this).find("input[type=checkbox]").attr("title", b);
        				if(c.length > 0) {
        					$(this).parent().parent().siblings().find("span.card-name").each(function(i, el) {
        						var b = $(el).text().trim();
            					if(b.length > 0) {
            						$(el).parent().parent().parent().parent().find("input[type=checkbox]").attr("title", b);
            					}
        					});
        				}
        			}
    			} else {
    				if($(this).find("input[type=checkbox]").is(":checked")) {
        				$(this).find("input[type=checkbox]").attr("title", b+", 선택됨");
        			} else {
        				$(this).find("input[type=checkbox]").attr("title", b);
        			}
    			}
    		}
    	});
    	$(".ui-radio-block").on("change", function() {
    		var a = $(this).find("span.ui-label-text").text().trim();
			if(a.length > 0) {
				if($(this).find("input[type=radio]").is(":checked")) {
    				$(this).find("input[type=radio]").attr("title", a+", 선택됨");
    				if($(this).parents(".ui-select-item").length > 0) {
    					$(this).parent().siblings().find("span.ui-label-text").each(function(i, el) {
        					var b = $(el).text().trim();
        					if(b.length > 0) {
        						$(el).parent().siblings().attr("title", b);
        					}
        				});
    				} else {
    					$(this).siblings().find("span.ui-label-text").each(function(i, el) {
        					var b = $(el).text().trim();
        					if(b.length > 0) {
        						$(el).parent().siblings().attr("title", b);
        					}
        				});
    				}
    			}
    		}
    	});
    	
    	$(".ui-checkbox-block, .ui-toggle-block").each(function(i, el) {
    		var a = $(el).find("span.ui-label-text").text().trim();
    		var b = $(el).find("input[type=checkbox]").attr("title");
    		var c = $(el).find("span.auth-select-title").text().trim();
    		var d = $(el).find("span.card-name").text().trim();
    		var e = $(el).find("input[type=radio]").is(":checked");
    		var f = $(el).find("span.detail-history-name").text().trim();
    		var g = $(el).find("input[type=checkbox]").is(":checked");
    		if(a.length > 0 || c.length > 0 || f.length > 0) {
    			$(el).find("input[type=checkbox]").attr("title", (a.length > 0 ? a : (c.length > 0 ? c : f)));
    			$(el).find("label").attr("aria-hidden", "true");
    		} else if(d.length > 0) {
    			$(el).find("input[type=radio]").attr("title", (e == true ? d+", 선택됨" : d));
    			$(el).find("input[type=checkbox]").attr("title", (g == true ? d+", 선택됨" : d));
    			$(el).find("label").attr("aria-hidden", "true");
    		} else if(b != undefined && b.trim().length > 0) {
    			$(el).find("label").attr("aria-hidden", "true");
    		}
    	});
    	$(".ui-radio-block, .auth-select-block").each(function(i, el) {
    		var a = $(el).find("span.ui-label-text").text().trim();
    		var b = $(el).find("input[type=radio]").attr("title");
    		var c = $(el).find("span.auth-select-title").text().trim();
    		var d = $(el).find("input[type=radio]").is(":checked");
    		if(a.length > 0 || c.length > 0) {
    			$(el).find("input[type=radio]").attr("title", (a.length > 0 ? (d == true ? a+", 선택됨" : a) : c));
    			if(a == "이달의 혜택" || a == "카드별 혜택") {
    				$(el).find("label").attr("aria-hidden", "false");
    			} else {
    				$(el).find("label").attr("aria-hidden", "true");
    			}
    		} else if(b != undefined && b.trim().length > 0) {
    			$(el).find("label").attr("aria-hidden", "true");
    		}
    	});
    	$(".ui-file-block").each(function(i, el) {
    		var a = $(el).find("span.ui-label-text").text().trim();
    		var b = $(el).find("input[type=file]").attr("title");
    		var c = $(el).find("span.auth-select-title").text().trim();
    		if(a.length > 0 || c.length > 0) {
    			$(el).find("input[type=file]").attr("title", (a.length > 0 ? a : c));
    			$(el).find("label").attr("aria-hidden", "true");
    		} else if(b != undefined && b.trim().length > 0) {
    			$(el).find("label").attr("aria-hidden", "true");
    		}
    	});
    });
    </script>
    
