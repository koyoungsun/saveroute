	<script type="text/javascript">	
	window.onload = function(){
		mkaEfdsInit();

		
		if( _isAppChannelRequest ){		
			setLoading(false);
			
			try {
				if( _isAosDeviceRequest && $(".fix-top-wrap .header .header-left .type-back").length > 0 ) {
					appBackEvent("aosBackEvent");
				}
			}
			catch(e) {}
		}
		
	};
	
	function aosBackEvent(){		
		$(".fix-top-wrap .header .header-left .type-back").click();
	}
	
	function _commWinLoadFn(){
		//각 확면별 window load function
		if( "function" === typeof(winLoadFn) ){
			winLoadFn();
		}
		
		//본인인증 Init 
		if( "function" === typeof(_AuthInit) ){
			_AuthInit();
		}
		
		mkaRebm("", "");
	}
	
	//이전페이지
  	 function goBackWeb(){
			if( "function"=== typeof(_backUrl) ){
				_backUrl();
			}else{
				goLinkWeb(_backUrl);	
			}
		}
 
	
	/**
	* urlTy
    *    - 00 : URL
    *    - 01 : NATIVE
    *    - 02 : SCRIPT
    *    - 03 : 외부링크 (새창 or 외부브라우저)
    *    - 10 : SSO (내부 WEBVIEW)
    *    - 11 : SSO (외부 브라우저)
    *    - 99 : 링크없음
	*/
	function goBannerLink(urlTy, url, appMenuId, menuTitle){	
		if( _isAppChannelRequest && "00"==urlTy && undefined != appMenuId && appMenuId.length > 0){
			urlTy = "01";
		}

		if( "00"==urlTy && url.indexOf("#") > -1 ){
			return;
		}
		
		//마이데이터, 오픈뱅킹, 전자문서 지갑
		if( !_isAppChannelRequest 
				&& (url.indexOf("/qwt/mydata.jsp") > -1 || url.indexOf("MKOBQ") > -1 || url.indexOf("MKEW") > -1) ){
			newWinConfirm.openLayer("PAYWEB", "APP", encodeURIComponent(url));
			return false;
		}
		
		switch( urlTy ){
			case "00":
				if( _isAppChannelRequest && url.indexOf("http") == 0) {
					appWebView(url, menuTitle);
				} else if (_isAppChannelRequest && url.indexOf("EVN_SEQ") > -1) {
					appWebView(url+"&_frame=noX");
				} else{
					if( _isMainTab ){
						goLinkWebView(url);
					}else{
						goLinkWeb(url);
					}
				}				
				break;
				
			case "01":
				goPayNative(appMenuId)
				break;
				
			case "02":
				eval(url);
				break;
				
			case "03":
				if( url.indexOf("http") != 0 ){
					url = "https://m.hanacard.co.kr" + url;
				}
				goNewWin(url);
				break;
				
			case "10":
				if( _isAppChannelRequest ){
					if( url.indexOf("?") ==- 1 ){
						url = url+"?";
					}else{
						url = url+"&";
					}
					
					url = url +"_frame=no";
					
					
					appSsoWebView("https://m.hanacard.co.kr/qwt/cardsvc.jsp?surl="+ encodeURIComponent(url), menuTitle);
					
				}else{
					// goBannerLink("00", "/MKQWT1000M.web?surl="+ encodeURIComponent(url));
					goLinkWeb("/qwt/cardsvc.jsp?surl="+ encodeURIComponent(url));
				}
				
				break;
				
			case "11":
				ajaxExceute2(
					"/MKQWT1000M.ajax"
					, { targetMethod : "generateToken" }
					, function(dataMap) {
						// goBannerLink("03", "/MKQWT1000M.web?token=" + dataMap.token + "&surl="+ encodeURIComponent(url));
						goBannerLink("03", "/qwt/cardsvc.jsp?token=" + dataMap.token + "&surl="+ encodeURIComponent(url));
					  }
					, null
					, {}
				);
				break;
			case "99":
				//링크없음
				break;
		}
	}
    
    function pop_close_focus(obj){ //23.8 웹접근성 처리 관련 레이업 팝업 닫고 초점 이동 추가
		setTimeout(function(){
			obj.focus();
		}, 500);
		
	}
    
	</script>
	
