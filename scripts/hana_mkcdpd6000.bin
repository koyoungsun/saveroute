<script type="text/javascript">
	var recommendKeyword = "";
	
	$(document).ready(function() {
		setRecommendKeyword();
	});
	
	function goMenuLink(menuId, urlTy, url, appMenuId, menuTitle){
		try{setRecentMenuList(menuId);}catch(J){}
		goBannerLink(urlTy, url, appMenuId, menuTitle);
	}
    
	function setRecentMenuList(menuId){
		var cKey     = "_MkaRecentMenuList";
		var cValue   = $.cookie(cKey);
		var newValue = [];
		
		if( undefined == cValue ){
			cValue = [];
		}else{
			cValue = cValue.split("X");
			$.each(cValue, function(idx, value) {
				if( menuId != value ){
					newValue.push(value);
				}
			});
			
			cValue   = newValue;
			newValue = [];
		}
		
		cValue.push(menuId);
		
		var valueSize = cValue.length;
		if( valueSize > 6 ){
			$.each(cValue, function(idx, value) {
				if( (valueSize)- idx <=6  ){
					newValue.push(value);
				}
			});
			
			cValue   = newValue;
			newValue = [];
		}
		
		$.cookie(cKey, cValue.join("X"), {expires:7});
	}
	
	// AOS/IOS 앱 버전 체크 
	var _appVersion = "0.0.0";
	
	
	function myDataFn(url, menuId){
		if(_isAppChannelRequest){
			if(_isAosDeviceRequest){
				if(appVerChk(_appVersion, "7.1.0", "MAX")){ // AOS 7.1.1 이상이면
					appMyDataMove(menuId,'qwt/mydata.jsp?surl='+url+'?MKA_YN=Y'); // MyData Native 화면 이동
				}else{
					goMyData('/'+url);
				}
			}else if(_isIosDeviceRequest){
				if(appVerChk(_appVersion, "7.0.7", "MAX")){ // IOS 7.0.8 이상이면
					appMyDataMove(menuId,'qwt/mydata.jsp?surl='+url+'?MKA_YN=Y'); // MyData Native 화면 이동
				}else{
					goMyData('/'+url);
				}
			}
		}else if(_isWebChannelRequest){
			goMyData('/'+url);
		}
	}
	
	function myDataFn2(url, menuId){
		if(_isAppChannelRequest){
			if(_isAosDeviceRequest){
				if(appVerChk(_appVersion, "7.1.0", "MAX")){ // AOS 7.1.1 이상이면
					appMyDataMove(menuId, 'qwt/mydata.jsp?surl='+url+'?MKA_YN=Y'); // MyData Native 화면 이동
				}else{
					goLinkWebView('https://pay.hanacard.co.kr/'+url);
				}
			}else if(_isIosDeviceRequest){
				if(appVerChk(_appVersion, "7.0.7", "MAX")){ // IOS 7.0.8 이상이면
					appMyDataMove(menuId, 'qwt/mydata.jsp?surl='+url+'?MKA_YN=Y'); // MyData Native 화면 이동
				}else{
					goLinkWebView('https://pay.hanacard.co.kr/'+url);
				}
			}
		}else if(_isWebChannelRequest){
			goLinkWebView('https://pay.hanacard.co.kr/'+url);
		}
	}
	
	/*
	* GLN ATM 앱 스킴 호출(최신버전에 따른 스킴 호출)
	*/
	function glnAtmFn(){
		var isLoginCheck		= false;			// 로그인 여부 
		
		if(isLoginCheck){
			if(_isAppChannelRequest){
				if(_isAosDeviceRequest){
					if(appVerChk(_appVersion, "7.6.1", "MAX")){ // AOS 7.6.2 이상이면
						window.location.href = "oneqpay://GLN/glnATM";
					}else{
						alert("GLN 현지 ATM 출금 서비스를 이용하기 위해서는 앱 업데이트가 필요합니다.");
						return;
					}
				}else if(_isIosDeviceRequest){
					if(appVerChk(_appVersion, "7.4.1", "MAX")){ // IOS 7.4.2 이상이면
						window.location.href = "oneqpay://GLN/glnATM";
					}else{
						alert("GLN 현지 ATM 출금 서비스를 이용하기 위해서는 앱 업데이트가 필요합니다.");
						return;
					}
				}
			}else if(_isWebChannelRequest){
				alert("하나페이 앱 최신버전의 앱부터 이용가능합니다. 하나페이 앱을 통해서 이용바랍니다.");
				return;
			}
		}else{
			alert("로그인 후 이용 가능합니다.");
			goLinkWeb("/MKLGN2000M.web");
		}
	}
	
	/*
	* GLN QR 앱 스킴 호출(최신버전에 따른 스킴 호출)
	*/
	function glnMainFn(menuId){
		var isLoginCheck = false;			// 로그인 여부 
		
		if(isLoginCheck){
			if(_isAppChannelRequest){
				if(_isAosDeviceRequest){
					if(appVerChk(_appVersion, "7.6.4", "MAX")){ // AOS 7.6.5 이상이면
						window.location.href = "oneqpay://GLN/glnMain";
					}else{
						appPageMove(menuId);
					}
				}else if(_isIosDeviceRequest){
					if(appVerChk(_appVersion, "7.4.4", "MAX")){ // IOS 7.4.5 이상이면
						window.location.href = "oneqpay://GLN/glnMain";
					}else{
						appPageMove(menuId);
					}
				}
			}else if(_isWebChannelRequest){
				alert("하나페이 앱 최신버전의 앱부터 이용가능합니다. 하나페이 앱을 통해서 이용바랍니다.");
				return;
			}
		}else{
			alert("로그인 후 이용 가능합니다.");
			goLinkWeb("/MKLGN2000M.web");
		}
	}
	
	var hmCnt = 0;
	
	function hmApptestcall() {
		hmCnt++;
		
		if(hmCnt == 5){
			hmApptest();
			hmCnt = 0;
		}
	}
	
	function hmApptest() {
		var server = "R";
		var type = "0";
		var menuNo = "";
		
		if( _isRealMode ){
			server = "R"	
		}else{
			server = "T"
		}
		var hsMinNetSchme = "HsMinNet.HS_MIN_WEB_ADD_VALUE?type=" + type + "&menu_no=" + menuNo + "&server_type=" + server + "&sso_type=HMT";
		var scheme = "oneqpay://"+hsMinNetSchme;

		if( _isAppChannelRequest ){
			location.href = scheme;
		}else{	
			if(_isAosDeviceRequest){
				scheme = scheme + "&intro=on";	
			}
			
			newWinConfirm.openLayer(scheme,'HANAMONEY');
		}
	}
	
	
	function doMenuSubmit(keyword, schTyStr){
		
		if ($("#menuKeyword").val() != "") {
			keyword = $("#menuKeyword").val();
		} else {
			if(undefined == keyword || keyword.length == 0) {
				keyword = recommendKeyword;
			}
		}
		
		keyword = keyword.trim();
		
		if(goTotalMenuSearch(keyword)){
			setLoading(true);
			setRecentMenuSchWord(keyword);
			goLinkParam("/MKSRCH1000M.web", "keyword="+keyword+"&isSynDomain=true&schTyStr="+schTyStr);
		}else{
			return false;
		}
	}
	
	
	function quickMenuSch( input ) {
		$("#menu_quick_search").addClass("is-empty");
		
		var keyword = ($(input).val()).trim();
		
		if( keyword.length == 0){
			$(input).attr("autocomplete", "on");
		}else{
			$(input).attr("autocomplete", "off");
		}
		
		if( keyword.length >= 2 && keyword.length <= 20){
			ajaxExceute2(
					 "/MKSRCH1000M.web"
					,{
						 keyword      : keyword
						,isSynDomain  : false     //동의어검색어부
						,targetMethod : "quickSch"
					 }
					,function(dataMap){
						if( dataMap.indexOf("ui-search-kewords-item") > -1  ){
							$("#menuQuickSch_DIV").html(dataMap);
							$("#menu_quick_search").removeClass("is-empty");
						}
					 }
					,function(dataMap){
						$("#menuQuickSch_DIV").html("");
						$("#menu_quick_search").addClass("is-empty");
					 }
					,{
						 dataType : "html"
						,isLoding : false //로딩바 노출안함.
					 }
			);
		}else{
			if( keyword.length > 20 ) {
				alert("검색어는 20자까지만 입력해 주세요.");
				$(input).val("");
			} else {
				$("#menuQuickSch_DIV").html("");
			}
		}
		
	}
	
	
	function goTotalMenuSearch(text){
		var stValue = text;
		var regExp = /^[0-9]+$/; //숫자 체크 정규식
		var emailReg = /^((\w|[\-\.])+)@((\w|[\-\.])+)\.([A-Za-z]+)$/; //이메일 체크 정규식
		var mobileReg = /^01([0|1|6|7|8|9]?)?([0-9]{3,4})?([0-9]{4})$/; //휴대전화번호 체크 정규식

		//휴대폰번호는 "/", ")", " " 공백 제거 후 10자리 숫자 이상일 경우 체크   
		var mobileValue = stValue.replace(/-/gi,"");
		mobileValue = mobileValue.replace(/\)/gi,"");
		mobileValue = mobileValue.replace(/ /gi,"");

		if(stValue.indexOf("\\") > -1 || stValue.length == 0){
			goLinkWebView("/MKSRCH1000M.web");
			return false;
		}else if( stValue.length > 20 ) {
			alert("검색어는 20자까지만 입력해 주세요.");
			return false;
		}else if (mobileValue.length >= 13 && regExp.test(mobileValue)) {
			alert("카드번호 및 주민번호는 검색 불가합니다.");
			return false;
		}else if (emailReg.test(stValue)) {
			alert("이메일 주소는 검색 불가합니다.");
			return false;
		}else if (mobileValue.length >= 10 && mobileReg.test(mobileValue)) {
			alert("휴대전화번호는 검색 불가합니다.");
			return false;
		}else {
			return true;
		}
	}
	
	
	function setRecentMenuSchWord(schWord) {
		var isLogin		= false;
		var cKey		= "_MkaRecentSchWord";
		var cValue		= $.cookie(cKey);
		var cValueSize	= 0;
		var newValue	= [];
		
		if (!isLogin) return;
		
		if (cValue == null || typeof(cValue) == "undefined") {
			cValue = [];
		} else {
			cValue = cValue.split("!^!");
			$.each(cValue, function(idx, value) {
				if (value != schWord) {
					newValue.push(value);
				}
			})
			
			cValue = newValue;
			newValue = [];
		}

		cValue.push(schWord);
		cValueSize = cValue.length;
		
		if (cValueSize > 5) {
			$.each(cValue, function(idx, value) {
				if ((cValueSize - idx) <= 5) {
					newValue.push(value);
				}
			})
			
			cValue = newValue;
		}
		
		$.cookie(cKey, cValue.join("!^!"), {expires:7});
	}
	
	
	function setRecommendKeyword() {
		var recommendSentence = "'카드', '메뉴', '혜택' 등을 검색해 보세요.";
		
		for (var i = 0; i < recSearchItems.length; i++) {
			if (recSearchItems[i].isRecUse) {
				recommendSentence = recSearchItems[i].recSentence;
				recommendKeyword = recSearchItems[i].recKeyword;
				break;
			}
		}
		
		$("#menuKeyword").attr("placeholder", recommendSentence)
	}
	
	
	function goNrlBankNarasarang(){
		const targetUrl = "/mbp/resource/html/BCOM/BCOM04/BCOM0400001.html";
		
			openExtBrowser("https://mbp.hanabank.com/oneqplus.jsp?MENUM"+ targetUrl);
		
	}
</script>

