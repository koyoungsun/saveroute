<script type="text/javascript">
//<![CDATA[
var _isRealMode = true;
var _mkaDomain  = "https://m.hanacard.co.kr";
var _svrDomain  = "https://m.hanacard.co.kr";
var _mpaDomain  = "https://smart.hanacard.co.kr";
var _payDomain  = "https://pay.hanacard.co.kr";
var _drtDomain  = "https://drt.hanacard.co.kr";
console.log("_isRealMode : "+ _isRealMode);
console.log("_menuUri    : MKCDPD6000M.web");
console.log("_isLogin    : false");

console.log("_mkaDomain  : "+ _mkaDomain );
console.log("_svrDomain  : "+ _svrDomain );
console.log("_mpaDomain  : "+ _mpaDomain );
console.log("_payDomain  : "+ _payDomain );
console.log("_drtDomain  : "+ _drtDomain );


var REQ_MAP;
var DATA_MAP;



/**
 * Cookie 정보 설정
 */
function setCookieData(name, value, days) {
	var expires = "";
	if (isNotEmpty(days)) {
		var today  = new Date();
	    var expire = new Date(today.getTime() + 1000*60*60*24*(parseNumber(days)));
	    expires = " expires="+ expire.toGMTString();
	} else {
	//	nothing.
	}
	
    document.cookie = name +"="+ escape(value) +";"+ expires;
}
/**
 * Cookie 정보 추출
 */
function getCookieData(name) {
	var index = document.cookie.indexOf(name + "=");
	if (index == -1) {
		return null;
	}
	var stTxt = document.cookie.indexOf("=", index) + 1;
	
	var edTxt = document.cookie.indexOf(";", stTxt);
	if (edTxt == -1) {
		edTxt = document.cookie.length;
	}
	
	return unescape(document.cookie.substring(stTxt, edTxt));
}

function isEmpty(str) {
	return (str == undefined || str == null || str == "");
}
function isNotEmpty(str) {
	return (isEmpty(str) == false);
}
function isBlank(str) {
	return isEmpty(str) || isEmpty(trimString(str));
}
function isNotBlank(str) {
	return (isBlank(str) == false);
}
function trimString(str) {
	return str.replace(/ /gi, "");
}
function emptyString(str) {
	return isEmpty(str) ? "" : str;
}
function blankString(str) {
	return isBlank(str) ? "" : str;
}
function isFunction(fn) {
	return (fn != undefined && fn != null && typeof fn == "function");
}
function isNotFunction(fn) {
	return (isFunction(fn) == false);
}

// 숫자 확인
function validNumber(val) {
	var regExp = /[^0-9]/g;
	if (regExp.test(val)) {
		return true;
	}
	
	return false;
}
// 숫자 값 (문자+숫자 인 경우 숫자만)
function valueNumber(val) {
	var replaceVal = val.replace(/[^0-9]/g, "");
	if (isEmpty(replaceVal)) {
		replaceVal = 0;
	} else {
		replaceVal = parseInt(replaceVal);
	}
	
	return replaceVal;
}
// 숫자 값 (문자+숫자 인 경우 0)
function parseNumber(str) {
	return isBlank(str) || isNaN(Number(str)) ? 0 : parseInt(str, 10);
}

// Page Access Log
function pageAccessLog(cdp, cdPdSeq, rpc, step, params) {
	var winLoc  = window.location;
	var winPath = winLoc.pathname;
	
	var page   = winPath.replace("/", "").replace(".web", "");
	var cdp    = isEmpty(cdp)    ? page : cdp;
	var rpc    = isEmpty(rpc)    ? "00" : rpc;
	var step   = isEmpty(step)   ? page : step;
	var params = isEmpty(params) ? ""   : "&"+ params;
	var log    = "/"+ cdp +".cdp?CD_PD_SEQ="+ cdPdSeq +"&RPC="+ rpc +"&STEP="+ step + params;
	/*
	console.log("page    : "+ page  );
	console.log("cdp     : "+ cdp   );
	console.log("rpc     : "+ rpc   );
	console.log("step    : "+ step  );
	console.log("params  : "+ params);
	console.log("log     : "+ log   );
	*/
	
//	$.get(winLoc.protocol +"//"+ winLoc.host + log);
	$("#outLinkLogTmp").attr("src", log);
}

/**
 * 하나카드 카드신청 버전에 따라 신규웹뷰 or 기존웹뷰 
 */
function sendAppUri(uri, appVer, appMinVer) {
	if (isEmpty(appVer)) {
		appVer = "0.0.0";
	}
	
	var _appVer    = appVer.replace(/\./g,"");    // 하나카드 앱버전
	var _appMinVer = appMinVer.replace(/\./g,""); // 하나카드 APP OCR 최소버전 (IOS, AOS)
	
	if (parseInt(_appVer) < parseInt(_appMinVer) || // 하나카드 앱버전이 APP OCR 버전 이하
		appMinVer == "0.0.0") { // APP_OCR 프로퍼티 버전이 미등록
		
		goLinkWebView(uri);
	} else {
		goNewWin(uri);
	}
}
//]]>
</script>

