<!-- 카드비교하기 -->



<script type="text/javascript">
// 숫자 3자리 comma 추가
function regularExpressComma(obj, digit) {
	var dotExp = /\./g;
	var numExp = /\D/g;
	var comExp = /\B(?=(\d{3})+(?!\d))/g;
	var objVal;
	
	if (typeof(obj) == "string" || typeof(obj) == "number") {
		objVal = (typeof(obj) == "string") ? obj : new String(obj).valueOf();
		objVal = trimLeftZero(objVal);
		
		if (isEmpty(objVal.match(dotExp))) {
			objVal = objVal.replace(numExp, "");
			objVal = objVal.replace(comExp, ",");
		} else if (objVal.match(dotExp).length == 1) {
			var obj01;
			var obj02;
			
			if (objVal.indexOf(".") == 0) {
				obj01 = "0";
			} else {
				obj01 = objVal.split(".")[0];
				obj01 = obj01.replace(numExp, "");
				obj01 = isBlank(obj01) ? "0" : new String(Number(obj01)).replace(comExp, ",");
			}
			obj02 = objVal.split(".")[1];
			obj02 = obj02.replace(numExp, "");
			obj02 = isBlank(obj02) ? "" : ("."+ obj02);
			
			objVal = obj01 + obj02;
		} else { // 2개 이상
			objVal = "0";
		}
	} else { // undefined, boolean, object, function
		objVal = "0";
	}
	
	return objVal;
}
// 숫자 3자리 comma 삭제
function regularExpressCommaRemove(val) {
	return isNotEmpty(val) ? val.replace(/(,)/g, "") : "";
}
</script>
<script type="text/javascript">
//<![CDATA[
var isCardDetail = false;

$(document).ready(function() {
	// 카드 비교 : 열기
	$("#cardCompareBox").click(function() {
		
		//비교함에 등록된 카드가 없을 경우
		if(CardCompare.list.length < 1){
			alert("카드 비교하기는 2개일 때 가능합니다.");
			return;
		}else {
			
			if(CardCompare.list.length < 2){
				$("#cardCompareProcess").prop("disabled", true);
			}else{
				$("#cardCompareProcess").prop("disabled", false);
			}
			
		}
		
		GA_Event('통합앱_카드상세','GNB영역','카드비교');
		uiJSLayer.open("cardCompare", $(this));
		//$("#cardCompareBox").focus();
	});
	
	// 카드 비교 : 닫기
	/* $("#cardCompareClose").click(function() {
		uiJSLayer.close("cardCompare");
		$("#cardCompareBox").focus();
	}); */
	
	CardCompare.init();
	
	var commonHeaderRightButtonObj = $("#COMM_HEADER_MANAGE_button");
	if (commonHeaderRightButtonObj.length) {
		if (commonHeaderRightButtonObj.css("display") == "block") {
			commonHeaderRightButtonObj.hide();
		}
		commonHeaderRightButtonObj.after($("#cardCompareBox"));
	}
	
	checkPopAdIsuCompare();

});


function checkPopAdIsuCompare() {
	let pathname = window.location.pathname;
	let isPopAdIsuCom = pathname.includes("MKCDCM3000M.web"); 
	
	
	if (isPopAdIsuCom) {
		$("#cardCompareBox").css("display", "none");
	}
}

var CardCompare = {
	list : new Array()
}

CardCompare.init = function() {
	
	if (isNotEmpty(getCookieData("_MkaCardCompare")) && getCookieData("_MkaCardCompare") != "[]") {
		var cardCompareJson = JSON.parse(getCookieData("_MkaCardCompare"));
		
		var cardInfoHtml = '';
		$.each(cardCompareJson, function(idx, value) {
			CardCompare.list.push(cardCompareJson[idx]);
			cardInfoHtml += CardCompare.cardInfo(cardCompareJson[idx]);
		});
		$("#cardCompareList").append(cardInfoHtml);
		$("#compareCount").html(CardCompare.list.length);
	} else {
		// nothing.
	}
}

CardCompare.add = function(card) {
	
	if (CardCompare.list.length > 1) {
		alert("최대 2개까지 비교 가능합니다.");
		return false;
	}
	
	var cardJson = {
		CD_ID             : card.CD_ID,
		CD_NO             : card.CD_NO,
		CD_NM             : card.CD_NM,
		LIST_IMG_TYPE_IMG : card.LIST_IMG_TYPE_IMG
	}
	CardCompare.list.push(cardJson);
	
	setCookieData("_MkaCardCompare", JSON.stringify(CardCompare.list));
	
	$("#compareCount").html(CardCompare.list.length);
	$("#cardCompareList").append(CardCompare.cardInfo(cardJson));
	
	return true;
}

CardCompare.remove = function(id) {
	
	$("#cardCompareClose").focus();
	
	for (var i=0; i<CardCompare.list.length; i++) {
		if (CardCompare.list[i].CD_ID == id) {
			CardCompare.list.splice(i, 1);
			break;
		}
	}
	
	setCookieData("_MkaCardCompare", JSON.stringify(CardCompare.list));
	
	$("#compareCount").html(CardCompare.list.length);
	
	$("li[id=cardInfo_"+ id +"]").remove();
	
	
	if (isCardDetail) {
		$("button[id=cardCompareBox_"+ id +"]").removeClass("is-active").attr("title", "추가");
	} else {
		$("button[id=cardCompareBox_"+ id +"]").removeClass("is-active").attr("title", "추가");
	}

	
	if (CardCompare.list.length < 1) {
		uiJSLayer.close("cardCompare");
	}else{
		if(CardCompare.list.length < 2){
			$("#cardCompareProcess").prop("disabled", true);
		}else{
			$("#cardCompareProcess").prop("disabled", false);
		}
	}
}

CardCompare.cookieValidation = function(id) {
	var isCookieValidation = false;
	if (isNotEmpty(getCookieData("_MkaCardCompare")) && getCookieData("_MkaCardCompare") != "[]") {
		var cardCompareJson = JSON.parse(getCookieData("_MkaCardCompare"));
		$.each(cardCompareJson, function(idx, val) {
		   if (cardCompareJson[idx].CD_ID == id) {
			   isCookieValidation = true;
			   return;
		   }
		});
	}
	
	return isCookieValidation;
}

CardCompare.cardInfo = function(card) {
	
	var cardInfoHtml = '';
	cardInfoHtml += '<li class="info-cards-item" id="cardInfo_'+ card.CD_ID +'">';
	cardInfoHtml += '	<div class="info-cards-link">';
	cardInfoHtml += '		<div class="card-image">';
	cardInfoHtml += '			<div class="card-image-inner">';
	cardInfoHtml += '				<img src="'+ card.LIST_IMG_TYPE_IMG +'" alt="" onerror="this.parentNode.className += \' is-error\';" />';
	cardInfoHtml += '			</div>';
	cardInfoHtml += '		</div>';
	
	cardInfoHtml += '		<div class="info-cards-explain">';
	cardInfoHtml += '			<div class="info-cards-title type-multi-ellipsis align-center">'+ card.CD_NM +'</div>';
	cardInfoHtml += '		</div>';
	
	cardInfoHtml += '		<button type="button" class="ui-button info-cards-delete" onclick="CardCompare.remove('+ "'"+ card.CD_ID +"'" +');">';
	cardInfoHtml += '			<span class="for-a11y">삭제</span>';
	cardInfoHtml += '		</button>';
	cardInfoHtml += '	</div>';
	cardInfoHtml += '</li>';
	
	
	return cardInfoHtml;
}

CardCompare.process = function() {
	
	if (CardCompare.list.length != 2) {
		alert("카드 비교하기는 2개일 때 가능합니다.");
		return;
	}
	
	var cdIds = "";
	for (var i=0; i<CardCompare.list.length; i++) {
		if ((CardCompare.list.length - 1) == i) {
			cdIds += CardCompare.list[i].CD_ID;
		} else {
			cdIds += CardCompare.list[i].CD_ID +",";
		}
	}
	
	
	GA_Event('통합앱_카드상세','카드_비교함','비교하기');
	
	var reqMap = {
		targetMethod : "cardCompare",
		cdIds        : cdIds
	}
	ajaxExceute("MKCDCM2010M.ajax", reqMap, cardCompareCallback);
}
function cardCompareCallback(dataMap) {
	
	if (dataMap.RESULT == "SUCCESS") {
		$("#compareListInfo").html('');
		$("#compareListBrand").html('');
		$("#compareListFee").html('');
		$("#compareListStandardPerformance").html('');
		$("#compareListBenefitOffer").html('');
		$("#compareListMainBenefit").html('');
		
		var cardData  = new Array();
		var cardImage = '';
		var cardHtml  = '';
		for (var i=0; i<CardCompare.list.length; i++) {
			cardData = dataMap.cardInfo[CardCompare.list[i].CD_ID];
			
			cardImage = isEmpty(cardData.LIST_LIS_TYPE_IMG) ? CardCompare.list[i].LIST_IMG_TYPE_IMG : cardData.LIST_LIS_TYPE_IMG;
			
			cardHtml = '';
			
			cardHtml += '<li class="info-cards-item">';
			cardHtml += '	<div class="info-cards-link">';
			cardHtml += '		<div class="card-image">';
			cardHtml += '			<div class="card-image-inner">';
			cardHtml += '				<img src="'+ cardImage +'" alt="'+ cardData.CD_NM +'" onerror="this.parentNode.className += \' is-error\';" />';
			cardHtml += '			</div>';
			cardHtml += '		</div>';
			cardHtml += '		<div class="info-cards-explain">';
			cardHtml += '			<div class="info-cards-title type-multi-ellipsis align-center">'+ cardData.CD_NM +'</div>';
			cardHtml += '		</div>';
			cardHtml += '	</div>';
			
			var BUTTON_LINK = "";
			var BUTTON_NAME = "";
			BUTTON_LINK = "javascript:goLinkWeb('/MKCDCM1000M.web?CD_PD_SEQ="+ cardData.CD_NO +"');";
			BUTTON_NAME = '상세보기';
			
			cardHtml +=
						'<div class="ui-buttons type-center margin-top-15">'+
							'<ul class="ui-buttons-list">'+
								'<li class="ui-buttons-item">'+
									'<a href="'+ BUTTON_LINK +'" class="ui-basic-button type-gray type-tiny">'+ BUTTON_NAME +'</a>'+
								'</li>'+
							'</ul>'+
						'</div>'+
					'</div>'+
				'</li>';
			
			$("#compareListInfo").append(cardHtml);
			
			cardHtml = '';
			if (isNotEmpty(cardData.BRAND_LIST)) {
			cardHtml +=
					'<div class="card-comparison-item">'+
						'<h4 class="for-a11y">'+ cardData.CD_NM +' 브랜드</h4>'+
						'<ul class="info-list type-outside">';
				for (var j=0; j<cardData.BRAND_LIST.length; j++) {
			cardHtml +=
							'<li class="info-item">'+ cardData.BRAND_LIST[j].BRAND_NM +'</li>';
				}
			cardHtml +=
						'</ul>'+
					'</div>';
			}
			$("#compareListBrand").append(cardHtml);
			
			
			cardHtml = '';
			if (isNotEmpty(cardData.FEE_LIST)) {
			cardHtml +=
					'<div class="card-comparison-item">'+
						'<h4 class="for-a11y">'+ cardData.CD_NM +' 연회비</h4>'+
						'<ul class="info-list type-outside">';
				for (var j=0; j<cardData.FEE_LIST.length; j++) {
			cardHtml +=
							'<li class="info-item">'+
								cardData.FEE_LIST[j].TP_NM;
				
					if (isNotEmpty(cardData.FEE_LIST[j].PRICE)) {
			cardHtml +=
								'<br>'+ regularExpressComma(cardData.FEE_LIST[j].PRICE) +' 원';
					}
					if (isNotEmpty(cardData.FEE_LIST[j].DETAIL_PRICE)) {
			cardHtml +=
								'<br>('+ cardData.FEE_LIST[j].DETAIL_PRICE +')';
					}
			cardHtml +=
							'</li>';
				}
			cardHtml +=
						'</ul>'+
					'</div>';
			}
			$("#compareListFee").append(cardHtml);
			
			
			cardHtml = '';
			if (isNotEmpty(cardData.STD_REC_HTML)) {
			cardHtml +=
					'<div class="card-comparison-item">'+
						'<h4 class="for-a11y">'+ cardData.CD_NM +' 기준실적</h4>'+
						'<ul class="info-list type-outside">'+
							cardData.STD_REC_HTML +
						'</ul>'+
					'</div>';
			}
			
			$("#compareListStandardPerformance").append(cardHtml);
			
			
			cardHtml = '';
			if (isNotEmpty(cardData.PRN_OFE_MTD)) {
			cardHtml +=
				'<div class="card-comparison-item">'+
					'<h4 class="for-a11y">'+ cardData.CD_NM +' 혜택제공방법</h4>'+
					'<ul class="info-list type-outside">'+
						cardData.PRN_OFE_MTD +
					'</ul>'+
				'</div>';
			}
			$("#compareListBenefitOffer").append(cardHtml);
			
			cardHtml = '';
			if (isNotEmpty(cardData.PRN_HTML)) {
				cardHtml +=
					'<div class="card-comparison-item">'+
						'<h4 class="for-a11y">'+ cardData.CD_NM +' 주요혜택</h4>'+
						'<ul class="info-list type-outside">'+
							cardData.PRN_HTML +
						'</ul>'+
					'</div>';
				}
			$("#compareListMainBenefit").append(cardHtml);
		}
		
		GA_Virtual("카드신청>공통>카드 비교함 팝업>카드 비교하기 팝업", "MKCDPD6000M.web");
		uiJSLayer.open("popCompareList", $("#cardCompareProcess"));
		
		//$("[data-layer='popCompareList']").find(".header__title").attr("tabindex", '0').focus().attr("tabindex", "");
		/**
		 * 웹접근성
		 */
		/* $("header, #cardCompare").attr({
			"aria-hidden":"true", "tabindex":"-999999999"
		});
		$("#focusTXT").attr("tabindex", 1).focus(); */
		
	//	gaVirtualFn();
	} else {
		// nothing.
	}
}

function popupCompareClose() {
	uiJSLayer.close("popCompareList");
	
	/**
	 * 웹접근성
	 */
	$("header").attr({
		"aria-hidden":"false", "tabindex":"1"
	});
	$("#cardCompare").attr({
		"aria-hidden":"false", "tabindex":"1"
	});
	$("#cardCompareProcess").focus();
}
//]]>

// GA 가상페이지뷰
function gaVirtualFn() {
	try {
		var virtualObj = new Object();
		virtualObj.event = 'ga_virtual'; //이벤트명
		
		virtualObj.virtualtitle = '카드비교함'; //페이지명
		virtualObj.virtuallocation = 'm.hanacard.co.kr/cardCompareBox';	//페이지URL
		virtualObj.dimension20 = '카드';	//depth1
		virtualObj.dimension21 = '카드>카드비교함';	//depth2
		virtualObj.dimension22 = '카드>카드비교함';	//depth3
		virtualObj.dimension23 = '카드>카드비교함';	//depth4
		virtualObj.dimension24 = '카드>카드비교함';	//depth5
		virtualObj.dimension25 = '카드>카드비교함';	//depth6
		
		GA_CommonFn(virtualObj);
	} catch (e) {
		console.log(e.message);
	} finally {
		return true;
	}
}
</script>

<!-- 공통헤더 > 카드비교함 -->
<button type="button" id="cardCompareBox" class="header-button type-compare">
	<span class="for-a11y">카드비교함</span>
	<span id="compareCount" class="header-button-number">0</span><span class="for-a11y">개</span>
</button>

<!-- 카드비교함 > 비교하기 -->
<div class="layer-wrap layer-wrap--slide" data-layer="cardCompare">
	<div class="layer-container">
		<section class="ui-layer">
			<div class="ui-layer__head">
				<div class="header">
					<h2 class="header__title">카드 비교함</h2>
					<div class="header__right">
						<button type="button" class="ui-button header__button header__button--close" data-role="layerClose">
							<span class="for-a11y">레이어 닫기</span>
						</button>
					</div>
				</div>
			</div>
			<div class="ui-layer__body">
				<div class="ui-layer__body-inner">
					<div class="info-cards type-regular type-tile">
						<div class="info-cards-inner">
							<ul id="cardCompareList" class="info-cards-list">
							</ul>
						</div>
					</div>
				</div>
			</div>
			<div class="ui-layer__foot">
				<div class="ui-buttons">
					<ul class="ui-buttons-list">
						<li class="ui-buttons-item">
							<button type="button" id="cardCompareProcess" onclick="CardCompare.process();" class="ui-button ui-basic-button type-primary">비교하기</button>
						</li>
					</ul>
				</div>
			</div>
