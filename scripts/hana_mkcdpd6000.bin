<form id="nForm" name="nForm" method="post"></form>
<div id="nfilter_document" class="ownKeypadWrap ownDrag" style="display: none"></div>

<script type="text/javascript">
	function mkaNfilterInit(ids, modes, callback){
		$("#nfilter_document").remove();
		nfilterInit(ids, modes, callback);
	}

	function mkaNfilterDataSet(frm){
		if( _isWebChannelRequest ){
			var nFilterValue = (_isWebChannelRequest == true ? nFilterEncrypted() : "") ;

			frm.find("input[name='_nFilterEncryptValue']" ).remove();
			frm.append($("<input/>", {type:"hidden", name:"_nFilterEncryptValue" , value:nFilterValue}));
		}
	}
</script>



	<script type="text/javascript">
		nshc.setFinishedCallback(function(){
			console.log("XXXXXXXXXXXXXXXXXXX>> nFilter Finished <<XXXXXXXXXXXXXXXXXXX");
			setLoading(false, "sub");

			//배경 화면 클릭시 nFilter Close
			$(".ownKeypadBG").click(function(){
				$("#nfilter_close").trigger("click");
			});
		});

		function nFilterEncrypted(){
			return nshc.encrypted();
		}

		function nfilterInit(ids, modes, callback){
			setLoading(true, "sub");

			nshc.setOnInitStart();

			var sizeDefault       = 320;
			var inputSpeedDefault = 200;

			for(var i = 0; i < ids.length; i++) {
				var id    = ids[i];
		 		var mode  = "qwerty"; //qwerty | number
				var dType = "pw";
		 		
				if( "CDNO" == ids[i] ) {
					mode  = "number";
					dType = "card2";

				} else if( "RRNO" == ids[i] || "SSN" == ids[i] || "SSN3" == ids[i] || "FML_SSN" == ids[i] || "SPS_SSN" == ids[i] ) {
					mode  = "number";
					dType = "id2";

				} else if( "PWD" == ids[i] || "PASSWORD" == ids[i] || "PASSWORD_OLD" == ids[i] || "PASSWORD_NEW" == ids[i] || "PASSWORD_CONFIRM" == ids[i] ) {
					mode  = "qwerty";
					dType = "pw";

				} else if( "CD_PSWD" == ids[i] || "CARD_PASSWORD" == ids[i] || "CARD_PASSWORD_CONFIRM" == ids[i] || "CVV_VDT_V" == ids[i] || "AFC_PAY_ACNO" == ids[i]) {
					mode = "number";
					dType = "pw";

				} else {
	 				if( undefined != modes && null != modes && undefined != modes[i] && null != modes[i] ) {
						mode  = modes[i];
						dType = "pw";
					}
				}

		 		if("card2" == dType){
		 			nshc.setViewFormatting(id + "=-;4;2^2*;4*;4");
		 			$("#"+id).attr("minLength","15");
		 			nshc.setChgPatternImmediate(id);

		 		}else if("id2" == dType){
		 			nshc.setViewFormatting(id + "=-;6;1^6*");
		 			$("#"+id).attr("minLength","13");

		 		}
				nshc.setCommon(document.getElementById(id), "mode=" + setMode(mode)); // PC, 쿼티


				/**
				 * callback(call)
				 * - "close" : 키패드 X 눌러 닫을 때
				 * - "enter" : 키패드 값 입력후 닫을 때
				 */
				if( "function" === typeof callback ) {
					nshc.ownCallback = callback;
				}
				
				//접근성 수정 talkback에서 이벤트 먹통방지 
				$("#" + id).removeAttr("role");
				$("#" + id).attr("aria-readonly", false);
				
				//접근성 수정, 보안키패드 표시 추가 2023.8
				var asTitle = $("#" + id).attr("title");
				
				if(asTitle == undefined){
					$("#" + id).attr("title"    , "보안키패드 입력");
				} else {
					$("#" + id).attr("title"    , asTitle+" (보안키패드)");	
				}
				
				
			}

			nshc.setInit();
		}

		function setMode(mode){
	 		/*
	 		pcCKpd : PC 문자키패드
	 		mCKpd  : 모바일 문자키패드
	 		nAKpd  : 3x4 숫자키패드
	 		nBKpd  : 4x3 숫자키패드
	 		nCKpd  : 2x6 숫자키패드
	 		*/

	 		if("number" == mode){
	 			mode = "nCKpd";
	 		}else if("qwerty" == mode){
	 			mode = "mCKpd";
	 		}else{
	 			mode = "mCKpd";
	 		}

	 		return mode;
	 	}
	</script>








	<script type="text/javascript" src="/js/af/jquery.xdomainrequest.min.js" charset="euc-kr"></script>
	<script type="text/javascript" src="/js/af/json2.js" charset="euc-kr"></script>
	<script type="text/javascript" src="/js/af/swfobject-min.js" charset="euc-kr"></script>
	
		<script type="text/javascript" src="/js/af/itraceraf.cfg.js" charset="euc-kr"></script>
	
	<script type="text/javascript" src="/js/af/itraceraf.min.js" charset="euc-kr"></script>


<script type="text/javascript">
	function mkaEfdsInit(isLoading){
		isLoading = isLoading==false ? false : true;		
		setLoading(isLoading, "efds");

		if( _isAppChannelRequest ){
			appEfds("sendEfdsData");
		}else{
			iTracerAF.init(function (data) {
				console.log("*** [mkaEfdsInit]iTracerAF.init OK! ");
				/* clearTimeout(timeout);
				*/
				var AF_W_DATA = data.wdata;
				var AF_UKEY = data.ukey.replace(/-/g,"");

				$("#AF_WDATA").val(AF_W_DATA);
				$("#U_DATA").val(AF_UKEY);

				callbackMkaEfdsData("", "", "", AF_W_DATA, AF_UKEY);
			});
		}
	}

	// [APP] EFDS 수집 결과
	function sendEfdsData(wData, natIp, uData) {
		callbackMkaEfdsData(wData, natIp, uData, "", "");
	}

	/**
	 *  모바일앱 수집 데이터 : wData, natIp, uData
	 *  모바일웹 수집 데이터 : AF_W_DATA, AF_UKEY
	 */
	function callbackMkaEfdsData(wData, natIp, uData, AF_W_DATA, AF_UKEY) {
		 /*{
			$("#etcDebugingDiv").append("<br/> eFDS TEST");
			$("#etcDebugingDiv").append("<br/>- wData : "+ wData);
			$("#etcDebugingDiv").append("<br/>- natIp : "+ natIp);
			$("#etcDebugingDiv").append("<br/>- uData : "+ uData);
			$("#etcDebugingDiv").append("<br/>- AF_W_DATA : "+ AF_W_DATA);
			$("#etcDebugingDiv").append("<br/>- AF_UKEY : "+ AF_UKEY);
			$("#etcDebugingDiv").show();
		}*/

		ajaxExceute2(
			 "/MKEFDS1000M.ajax"
			,{
				 ipinsideData  : wData
				,ipinsideNAT   : natIp
				,ipinsideUData : uData
				,AF_W_DATA     : AF_W_DATA
				,AF_UKEY       : AF_UKEY
			}
			,mkaEfdsAfterFn
			,mkaEfdsAfterFn
			,{
				isLoding : false
			 }
		);
	}

	function mkaEfdsAfterFn(dataMap){
		setLoading(false, "efds");

		//각 확면별 window load function
		_commWinLoadFn();
	}
</script>

<!-- layer: CVV 안내 -->
<div class="layer-wrap layer-wrap--slide type-no-dim" data-layer="layer-info-cvv">
	<div class="layer-container">
		<section class="ui-layer">
			<div class="ui-layer__head">
				<div class="header">
					<h2 class="header__title">CVV 번호란?</h2>
				</div>
			</div>
			<div class="ui-layer__body">
				<div class="ui-layer__body-inner">
					<div class="info-area type-cvv">
						<ul class="info-list">
							<li class="info-item">카드 뒷면 서명란 끝 3자리 숫자</li>
							<li class="info-item">CVV번호를 연속 5회 잘못 입력할 경우 해당 카드로 온라인 서비스 이용이 중단됩니다.</li>
						</ul>
					</div>
				</div>
			</div>
			<div class="ui-layer__foot">
				<div class="ui-buttons">
					<ul class="ui-buttons-list">
						<li class="ui-buttons-item">
							<button type="button" class="ui-button ui-basic-button type-primary" data-role="layerClose" onclick="javascript:pop_close_focus(cvvInfoBT);">확인</button>
						</li>
					</ul>
				</div>
			</div>
		</section>
	</div>
</div>
<!-- //layer: CVV 안내 -->
