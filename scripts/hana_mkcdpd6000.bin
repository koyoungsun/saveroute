			recSentence : "일본 항공권 왕복 9만원대~",
		},
		{
			isRecUse : false,
			recKeyword : "KTX",
			recSentence : "KTX 20% 할인'을 검색해보세요",
		},
		{
			isRecUse : false,
			recKeyword : "니콘내콘",
			recSentence : "모바일 쿠폰 최대 2천원 할인받기!",
		},
	];

function goOverseaPayment() {
	if (_isAosDeviceRequest) {
		var schemeUrl = "jsunity://mainsubpage?id=5";
		appSchemeCall(schemeUrl);
		return;
	} else {
		appPageMove("50005");
	}
}
