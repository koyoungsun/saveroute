<script>
//AOS/IOS 앱 버전 체크
var _appVersion = "0.0.0";

function goHanaWts(targetUrl){
	
	localStorage.setItem('hanaWtsTargetUrl',targetUrl);
	var schemeUrl = "oneqpay://oneSignToken?returnJS=jwsCallBack";
	
	setTimeout(function(){
		window.location.href = schemeUrl;
	},100);
	
	return; 
}

function jwsCallBack(jws){
	var targetUrl = localStorage.getItem('hanaWtsTargetUrl'); 
	if(jws == ""){
		
		alert("하나카드를 이용 중인 손님만 이용 가능합니다.");
		
		return;
	}
	
	onesignSsoInsert.ssoHistInsert(targetUrl, "HT");	// SSO 로그인 이력 적재 추가(하나증권 원사인인증서 버전)
	
	var url = "";
	
		url = "https://mstock.hanaw.com/1q/login/login.cmd?relCd=HCD&targetUrl="+targetUrl+"&jws="+jws;
	
	var menuTitle = '하나증권';
	setTimeout(function(){
		if((_isAosDeviceRequest && appVerChk(_appVersion, "7.4.3", "MAX")) || (_isIosDeviceRequest && appVerChk(_appVersion, "7.2.9", "MAX"))){ //AOS 7.4.4 이상이면, IOS 7.3.0 이상이면
			window.location.href = 'mydata://newWebView?url=' + encodeURIComponent(url) + '&callBack=webview&title_visibility=gone&isTabBar=N&menuTitle='+encodeURIComponent(menuTitle)+'&rightBtnType=home&leftBtnType=&login=N&webViewType=W_SSO&decodeTitleYn=Y';
		}else{
			window.location.href = 'mydata://newWebView?url=' + encodeURIComponent(url) + '&callBack=webview&title_visibility=show&menuTitle='+encodeURIComponent(menuTitle)+'&rightBtnType=home&leftBtnType=&login=N&webViewType=W_SSO&decodeTitleYn=Y';
		}
	},100);
	
	return; 
}


</script>


